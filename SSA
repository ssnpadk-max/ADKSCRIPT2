local inputCodeText = ""
CodesTab:Input({
    Title = "أدخل كود البريميوم",
    Placeholder = "أدخل الكود هنا...",
    Callback = function(txt)
        inputCodeText = txt
    end
})

CodesTab:Button({
    Title = "تفعيل الكود 🎁",
    Callback = function()
        local inputCode = string.upper(string.gsub(inputCodeText, "%s+", ""))
        if inputCode == "" then
            notify("تنبيه", "⚠️ يرجى كتابة الكود أولاً!")
            return
        end

        if not validCodes[inputCode] then
            notify("خطأ", "❌ الكود غير صحيح!")
            return
        end

        if codeData.usedCodes[inputCode] then
            notify("خطأ", "❌ هذا الكود تم استخدامه سابقاً ولا يمكن استخدامه مجدداً!")
            return
        end

        codeData.usedCodes[inputCode] = player.Name
        local currentTime = os.time()
        local currentExpiry = (codeData.premiumUntil and codeData.premiumUntil > currentTime) and codeData.premiumUntil or currentTime
        codeData.premiumUntil = currentExpiry + (7 * 24 * 60 * 60)
        saveCodeData()

        isPremiumUser = true
        notify("مبروك! 🌟", "🎉 تم تفعيل البريميوم لمدة 7 أيام بنجاح!", 5)
    end
})

