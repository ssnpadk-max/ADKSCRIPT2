-- Logic Variables
local isAscending = false
local isControlling = false
local defaultHeight = 35
local currentSpeed = 70
local activeBall, bodyVelocity, heartbeatConn, controlConn

local function getFootball()
    return workspace:FindFirstChild("Football")
end

local function startAscend()
    if not activeBall or isControlling then return end
    activeBall.Velocity = Vector3.new(0, 25, 0)
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(4000, 40000, 4000)
    bodyVelocity.Velocity = Vector3.new(0, 25, 0)
    bodyVelocity.Parent = activeBall

    local distance = 0
    heartbeatConn = RunService.Heartbeat:Connect(function(dt)
        if not isAscending or not activeBall or not activeBall.Parent or isControlling then
            if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
            if heartbeatConn then heartbeatConn:Disconnect() heartbeatConn = nil end
            return
        end
        distance = distance + (85 * dt)
        local offsetX = math.cos(distance) * 5
        local offsetZ = math.sin(distance) * 5
        local targetPos = Vector3.new(activeBall.Position.X + offsetX, defaultHeight, activeBall.Position.Z + offsetZ)
        local dir = (targetPos - activeBall.Position).Unit
        activeBall.Velocity = dir * 85
    end)
end

RunService.Heartbeat:Connect(function()
    if isAscending and activeBall and not isControlling then
        if activeBall.Position.Y < defaultHeight then
            activeBall.Velocity = Vector3.new(0, 25, 0)
        else
            activeBall.Velocity = Vector3.new(0, 25, 0)
            local moveDir = Humanoid.MoveDirection
            if moveDir.Magnitude > 0 then
                activeBall.Position = activeBall.Position + ((moveDir * currentSpeed) / 10)
            end
        end
    end
end)

local function startControl()
    if not activeBall then return end
    if heartbeatConn then heartbeatConn:Disconnect() heartbeatConn = nil end
    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end

    Camera.CameraSubject = activeBall
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Parent = activeBall

    controlConn = RunService.Heartbeat:Connect(function()
        if not isControlling or not activeBall or not activeBall.Parent then
            bodyVelocity:Destroy()
            Camera.CameraSubject = Character
            if controlConn then controlConn:Disconnect() end
            return
        end
        bodyVelocity.Velocity = Camera.CFrame.LookVector * currentSpeed
    end)
end

AscendBtn.MouseButton1Click:Connect(function()
    if isAscending then
        isAscending = false
        AscendBtn.Text = "ASCEND"
        AscendStroke.Color = Color3.fromRGB(0, 162, 255)
        LoadAnim:Stop()
        if heartbeatConn then heartbeatConn:Disconnect() heartbeatConn = nil end
        if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
    else
        isAscending = true
        AscendBtn.Text = "STOP"
        AscendStroke.Color = Color3.fromRGB(255, 50, 50)
        LoadAnim:Play()
        activeBall = getFootball()
        if activeBall then
            startAscend()
        end
    end
end)

ControlBtn.MouseButton1Click:Connect(function()
    if not activeBall then
        activeBall = getFootball()
        if not activeBall then 
            warn("No Ball Found!")
            return 
        end
    end
    isControlling = not isControlling
    ControlStroke.Color = isControlling and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(150, 0, 255)
    MainFrame.Visible = isControlling

    if isControlling then
        startControl()
    elseif isAscending then
        startAscend()
    end
end)

-- Slider Dragging System
local dragging = false
SliderFill.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

RunService.RenderStepped:Connect(function()
    if dragging then
        local mouseX = UserInputService:GetMouseLocation().X
        local trackX = SliderTrack.AbsolutePosition.X
        local trackSize = SliderTrack.AbsoluteSize.X
        local percentage = math.clamp((mouseX - trackX) / trackSize, 0, 1)
        
        SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
        currentSpeed = math.floor(20 + (percentage * 220)) -- السرعة بين 20 و 240
        SpeedLabel.Text = "Speed: " .. tostring(currentSpeed)
    end
end)

-- Keybinds (Y for Ascend, U for Control)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Y then
        AscendBtn.MouseButton1Click:Fire()
    elseif input.KeyCode == Enum.KeyCode.U then
        ControlBtn.MouseButton1Click:Fire()
    end
end)

