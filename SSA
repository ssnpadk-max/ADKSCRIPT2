-- 3. المحرك الذكي للبحث عن منطقة الفوز (Auto Target Finder)
--======================================
local ignoreList = {"leaderboard", "board", "display", "gui", "ui", "stat", "top", "rank", "podium", "sign", "wall", "text", "spawn", "lobby", "shop"}
local winKeywords = {"finish", "win", "endpad", "chest", "goal", "trophy", "final", "rewardpad"}

local function GetAutoWinPart()
    -- البحث في الخريطة عن خط النهاية أو الصندوق
    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and not obj:IsDescendantOf(player.Character or game) then
            local name = obj.Name:lower()
            
            -- التأكد من عدم وجود الكلمة في قائمة الحظر
            local isIgnored = false
            for _, bad in ipairs(ignoreList) do
                if name:find(bad) then
                    isIgnored = true
                    break
                end
            end
            
            if not isIgnored then
                for _, winKw in ipairs(winKeywords) do
                    if name:find(winKw) then
                        if obj:IsA("Model") then
                            local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            if primary then return primary end
                        elseif obj:IsA("BasePart") then
                            return obj
                        end
                    end
                end
            end
        end
    end
    return nil
end

