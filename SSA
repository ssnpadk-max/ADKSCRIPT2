-- [خاصية جديدة 1]: Auto Win (Smooth Travel) المدمجة من السكربت الثاني
local autoWinEnabled = false
FarmTab:Toggle({
    Title = "🏆 Auto Win (Smooth Travel)",
    Value = false,
    Callback = function(state)
        autoWinEnabled = state
        if state then
            task.spawn(function()
                while autoWinEnabled do
                    local char = player.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    
                    if root and winPos then
                        local dist = (root.Position - winPos).Magnitude

                        if dist > 5 then
                            -- 1. الارتفاع للأعلى
                            notify("Auto Win 🏆", "جارٍ الارتفاع للأعلى...", 2)
                            local riseStart = root.CFrame
                            local riseEnd = riseStart * CFrame.new(0, winHeight, 0)

                            for i = 0, 1, 0.05 do
                                if not autoWinEnabled or not root.Parent then break end
                                root.CFrame = riseStart:Lerp(riseEnd, i)
                                task.wait(0.02)
                            end

                            if not autoWinEnabled or not root.Parent then return end
                            task.wait(0.2)

                            -- 2. الانتقال الأفقي للموقع
                            notify("Auto Win 🏆", "جارٍ الانتقال لخط النهاية...", 2)
                            local startCF = root.CFrame
                            local targetPos = Vector3.new(winPos.X, root.Position.Y, winPos.Z)
                            local targetCF = CFrame.new(targetPos, Vector3.new(targetPos.X, targetPos.Y, targetPos.Z + 1))

                            local distance = (root.Position - targetPos).Magnitude
                            local steps = math.floor(distance / (winSpeed / 30))

                            for i = 1, steps do
                                if not autoWinEnabled or not root.Parent then break end
                                root.CFrame = startCF:Lerp(targetCF, i/steps)
                                task.wait(0.03)
                            end

                            if not autoWinEnabled or not root.Parent then return end
                            task.wait(0.2)

                            -- 3. الهبوط إلى النقطة النهائية
                            notify("Auto Win 🏆", "جارٍ الهبوط والمطالبة بالفوز...", 2)
                            local currentCF = root.CFrame
                            local finalCF = CFrame.new(winPos)

                            for i = 0, 1, 0.01 do
                                if not autoWinEnabled or not root.Parent then break end
                                root.CFrame = currentCF:Lerp(finalCF, i)
                                task.wait(0.01)
                            end

                            if root.Parent then root.CFrame = finalCF end

                            notify("Auto Win 🏆", "تم الوصول! إعادة التجميع خلال 3 ثوانٍ...", 3)
                            task.wait(3)

                            -- إعادة الرسبون لتكرار العملية
                            local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                            if hum then hum.Health = 0 end

                            notify("Auto Win 🏆", "جارٍ إعادة الرسبون... الدورة القادمة بعد 5 ثوانٍ", 5)
                            task.wait(5)
                        end
                    end
                    task.wait(0.1)
                end
            end)
        end
    end
})

