-- 3. محرك تجميع وترتيب مراحل العالم بالترتيب (Sequential Stage Collector)
--======================================
local function GetOrderedStagesForSelectedWorld()
    local targetWorldNum = tonumber(string.match(Cfg.SelectedWorld, "%d+")) or 1
    local stages = {}
    
    -- الكلمات الدالة على العالم المختار
    local worldKeys = {
        "world" .. targetWorldNum, "world_" .. targetWorldNum, "world " .. targetWorldNum,
        "w" .. targetWorldNum, "zone" .. targetWorldNum, "stage" .. targetWorldNum, "area" .. targetWorldNum
    }
    
    local blacklist = {"leaderboard", "board", "display", "gui", "ui", "stat", "top", "rank", "podium", "shop"}
    local stageKeywords = {"stage", "door", "gate", "wall", "zone", "win", "pad", "chest", "checkpoint", "part"}

    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and not obj:IsDescendantOf(player.Character or game) then
            local fullName = obj:GetFullName():lower()
            local name     = obj.Name:lower()

            -- التأكد من عدم وجود كلمات الحظر
            local isBlacklisted = false
            for _, bad in ipairs(blacklist) do
                if fullName:find(bad) then isBlacklisted = true; break end
            end

            if not isBlacklisted then
                -- فحص انتماء المجسم للعالم المحدد
                local isCurrentWorld = false
                for _, wKey in ipairs(worldKeys) do
                    if fullName:find(wKey) then isCurrentWorld = true; break end
                end

                -- إذا لم تكن العوالم مفصولة بمجلدات، نجمع كل الأبواب والمراحل
                if isCurrentWorld or targetWorldNum == 1 then
                    for _, kw in ipairs(stageKeywords) do
                        if name:find(kw) then
                            local partToUse = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
                            if partToUse then
                                table.insert(stages, partToUse)
                                break
                            end
                        end
                    end
                end
            end
        end
    end

    -- ترتيب المراحل حسب المسافة من نقطة البداية إلى النهاية (ترتيب متسلسل)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if root and #stages > 0 then
        local startPos = root.Position
        table.sort(stages, function(a, b)
            -- إذا كانت الأسماء تحتوي على أرقام (Stage 1, Stage 2...) يرتبها برقم المرحلة
            local numA = tonumber(string.match(a.Name, "%d+")) or tonumber(string.match(a.Parent.Name, "%d+"))
            local numB = tonumber(string.match(b.Name, "%d+")) or tonumber(string.match(b.Parent.Name, "%d+"))
            
            if numA and numB and numA ~= numB then
                return numA < numB
            else
                -- وإلا يرتبها حسب المسافة التسلسلية
                return (a.Position - startPos).Magnitude < (b.Position - startPos).Magnitude
            end
        end)
    end

    return stages
end

