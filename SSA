-- 3. المحرك الذكي المطور للتمييز بين العوالم (World-Aware Finder)
--======================================
local ignoreList = {"leaderboard", "board", "display", "gui", "ui", "stat", "top", "rank", "podium", "sign", "wall", "text", "spawn", "lobby", "shop"}
local winKeywords = {"finish", "win", "endpad", "chest", "goal", "trophy", "final", "rewardpad", "door"}

local FoundPadsList = {}

local function ScanAndGetWinPart()
    -- إذا قام المستخدم بانتخاب نقطة محددة من القائمة
    if Cfg.ManualSelectedPad and Cfg.ManualSelectedPad.Parent then
        return Cfg.ManualSelectedPad
    end

    local candidates = {}
    local targetWorldNum = tonumber(string.match(Cfg.SelectedWorld or "", "%d+")) -- 1 أو 2 أو 3

    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and not obj:IsDescendantOf(player.Character or game) then
            local name = obj.Name:lower()
            local parentName = obj.Parent and obj.Parent.Name:lower() or ""
            local fullName = obj:GetFullName():lower()

            -- استبعاد الشاشات والليدربورد
            local isIgnored = false
            for _, bad in ipairs(ignoreList) do
                if name:find(bad) or parentName:find(bad) then
                    isIgnored = true
                    break
                end
            end

            if not isIgnored then
                -- الفحص عن كلمات الكسب والـ Wins
                local isWin = false
                for _, winKw in ipairs(winKeywords) do
                    if name:find(winKw) or parentName:find(winKw) then
                        isWin = true
                        break
                    end
                end

                if isWin then
                    local partToUse = nil
                    if obj:IsA("Model") then
                        partToUse = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    elseif obj:IsA("BasePart") then
                        partToUse = obj
                    end

                    if partToUse then
                        local charRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                        local dist = charRoot and (charRoot.Position - partToUse.Position).Magnitude or 99999
                        table.insert(candidates, {
                            part = partToUse,
                            fullName = fullName,
                            dist = dist
                        })
                    end
                end
            end
        end
    end

    if #candidates == 0 then return nil end

    -- فلترة خاصة بالعوالم إذا تم اختيار World 1 / World 2 / World 3
    if targetWorldNum then
        local worldMatches = {}
        local searchKeys = {
            "world" .. targetWorldNum,
            "world_" .. targetWorldNum,
            "world " .. targetWorldNum,
            "w" .. targetWorldNum,
            "zone" .. targetWorldNum,
            "zone_" .. targetWorldNum,
            "stage" .. targetWorldNum,
            "stage_" .. targetWorldNum,
            "area" .. targetWorldNum
        }

        for _, cand in ipairs(candidates) do
            for _, key in ipairs(searchKeys) do
                if cand.fullName:find(key) then
                    table.insert(worldMatches, cand)
                    break
                end
            end
        end

        -- إذا وجد نقاط مطابقة للعالم المختار (مثلاً World 2)
        if #worldMatches > 0 then
            table.sort(worldMatches, function(a, b) return a.dist < b.dist end)
            return worldMatches[1].part
        end
    end

    -- في حال لم يجد اسماً مخصصاً للعالم، ترتيب حسب الأقرب لموقع اللاعب حالياً
    table.sort(candidates, function(a, b) return a.dist < b.dist end)
    return candidates[1].part
end

