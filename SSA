-- 3. نظام البحث التلقائي عن مناطق الفوز لكل العوالم
--======================================
local function FindWorldWinTarget()
    -- البحث عن منصات النهاية أو الصناديق في الخريطة الحالية
    local possibleNames = {"finish", "win", "end", "chest", "trophy", "final", "goal", "stageend", "partwin"}
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            for _, kw in ipairs(possibleNames) do
                if name:find(kw) then
                    if obj:IsA("Model") then
                        return obj:GetPivot().Position
                    else
                        return obj.Position
                    end
                end
            end
        end
    end
    
    -- إحداثيات احتياطية للعوالم المختلفة في حال لم يجد اسماً
    if Cfg.SelectedWorld == "World 1" then
        return Vector3.new(0, 50, -1000)
    elseif Cfg.SelectedWorld == "World 2" then
        return Vector3.new(1000, 50, 0)
    elseif Cfg.SelectedWorld == "World 3" then
        return Vector3.new(-1482, -56, -16)
    end

    return nil
end

